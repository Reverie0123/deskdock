// Version information and icon for deskdock-helper.exe. Heuristic AV engines treat a bare exe without any
// version resource as more suspicious; this also shows a sensible name in Task Manager and file properties.
#include <windows.h>

1 ICON "../../resources/deskdock.ico"
// RT_MANIFEST: common controls v6 (TaskDialog for the "ask" box) and per-monitor DPI awareness
1 24 "deskdock.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "DeskDock (open source, github.com/Reverie0123/deskdock)"
      VALUE "FileDescription",  "DeskDock: tray icon, and the native engine for the DeskDock MCP server (--helper)"
      VALUE "FileVersion",      "0.1.0.0"
      VALUE "InternalName",     "deskdock-native"
      VALUE "LegalCopyright",   "MIT License"
      VALUE "OriginalFilename", "deskdock-native.exe"
      VALUE "ProductName",      "DeskDock"
      VALUE "ProductVersion",   "0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
