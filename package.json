{
  "name": "deskdock",
  "version": "0.1.0",
  "description": "DeskDock: let Claude, Cursor or any model safely operate any Windows app. 桌面扩展坞：让 AI 安全地操作任意 Windows 程序。",
  "license": "MIT",
  "author": "Reverie0123",
  "type": "module",
  "bin": {
    "deskdock": "dist/index.js"
  },
  "files": [
    "dist",
    "resources",
    "manifest.json",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md",
    "llms-install.md",
    "PRIVACY.md",
    "install.ps1"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:e2e": "node tests/e2e/notepad.e2e.mjs",
    "tray": "start resources/deskdock-native.exe",
    "prepublishOnly": "npm run build:native && npm run build && npm test",
    "pack:mcpb": "npx @anthropic-ai/mcpb pack . dist-mcpb/deskdock.mcpb",
    "build:native": "windres native/helper/helper.rc -O coff -o native/native_res.o && g++ -O2 -std=c++17 -static -s -Wall -Wno-misleading-indentation -mwindows -municode -o resources/deskdock-native.exe native/main.cpp native/native_res.o -lole32 -loleaut32 -luuid -lgdiplus -lgdi32 -luser32 -ldwmapi -loleacc -lshlwapi -limm32 -ladvapi32 -lshell32"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "windows",
    "desktop-automation",
    "computer-use",
    "ui-automation",
    "claude",
    "cursor",
    "agent"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "mcpName": "io.github.Reverie0123/deskdock",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Reverie0123/deskdock.git"
  },
  "homepage": "https://github.com/Reverie0123/deskdock#readme",
  "bugs": {
    "url": "https://github.com/Reverie0123/deskdock/issues"
  }
}
